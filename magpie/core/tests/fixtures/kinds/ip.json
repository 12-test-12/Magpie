{
  "kind": "ip",
  "lens": "assets",
  "identity_rule": "单个 IP 地址的规范写法（normalize.normalize_ip）；IPv4-mapped IPv6（::ffff:1.2.3.4）折成 IPv4。**网段是另一种 kind**，不在这里折叠 —— 把 1.2.3.4 与 1.2.3.0/24 认成同一个实体，会让「哪台机器」的答案变成「哪一段」。",
  "golden": [
    "httpx/1",
    "js-manifest/2"
  ],
  "examples": [
    {
      "rule": "normalize.normalize_ip",
      "args": [
        "203.0.113.10"
      ],
      "key": "203.0.113.10",
      "why": "已经是规范写法"
    },
    {
      "rule": "normalize.normalize_ip",
      "args": [
        "::ffff:203.0.113.13"
      ],
      "key": "203.0.113.13",
      "why": "IPv4-mapped IPv6 指的是同一台机器"
    },
    {
      "rule": "normalize.normalize_ip",
      "args": [
        "2001:DB8::1"
      ],
      "key": "2001:db8::1",
      "why": "IPv6 十六进制小写化，同一地址只有一种写法"
    }
  ],
  "rejects": [
    {
      "rule": "normalize.normalize_ip",
      "args": [
        "203.0.113.0/24"
      ],
      "why": "网段是另一种 kind —— 混进来会让「哪台机器」的答案变成「哪一段」"
    },
    {
      "rule": "normalize.normalize_ip",
      "args": [
        "999.1.1.1"
      ],
      "why": "越界八位组"
    },
    {
      "rule": "normalize.normalize_ip",
      "args": [
        ""
      ],
      "why": "空串"
    }
  ]
}
